{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./.config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@nui/*": ["packages/*/src"],
      "@/*": ["packages/core/src/*", "packages/vite-plugin-docs/src/*"]
    }
  },
  "include": ["packages", "apps"],
  "exclude": ["node_modules", "dist", "build"]
}
